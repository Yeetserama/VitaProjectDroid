# PlayStation Vita buttons (Syscon)
# Linux keycodes from drivers/input/joystick/vita-buttons.c
keyboard.layout = PlayStationVita
keyboard.builtIn = 1
keyboard.orientationAware = 0

key 544   DPAD_UP
key 545   DPAD_DOWN
key 546   DPAD_LEFT
key 547   DPAD_RIGHT

key 304   BUTTON_A
key 305   BUTTON_B
key 307   BUTTON_X
key 308   BUTTON_Y

key 310   BUTTON_L1
key 311   BUTTON_R1

key 314   BUTTON_SELECT
key 315   BUTTON_START
key 316   BUTTON_MODE

key 115   VOLUME_UP
key 114   VOLUME_DOWN
key 116   POWER
