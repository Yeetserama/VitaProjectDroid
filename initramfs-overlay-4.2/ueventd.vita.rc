# Device permissions for the PlayStation Vita.
#
# This file is loaded by ueventd after /ueventd.rc.  The generic Android
# rules already cover /dev/input/*, /dev/ashmem, /dev/binder, /dev/uinput and
# /dev/graphics/*; these entries add the Vita-specific nodes.

/dev/graphics/fb0       0660   root       graphics
/dev/sw_sync            0660   system     graphics
/dev/ttyS0              0660   root       system
/dev/mmcblk0            0660   root       system
/dev/mmcblk0p12         0660   root       system
/dev/block/mmcblk0p12   0660   root       system
/dev/zram0              0660   root       system
/dev/block/zram0        0660   root       system
/dev/log_main           0666   root       log
/dev/log_radio          0666   root       log
/dev/log_events         0666   root       log
/dev/log_system         0666   root       log
/dev/lowmemorykiller    0660   root       system