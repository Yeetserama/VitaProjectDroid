# Android 4.2 platform init for the PlayStation Vita (PCH-1000).
#
# Imported from init.rc via:
#     import /init.${ro.hardware}.rc
# with androidboot.hardware=vita on the kernel command line.

on init
    # Stock devices export this from init.<hardware>.rc; the SDK ramdisk's
    # init.environ.rc does not.  android.os.Debug.<clinit> builds its default
    # trace path with Environment.getLegacyExternalStorageDirectory(), which
    # calls new File(System.getenv("EXTERNAL_STORAGE")) without a null check.
    # Without the variable, Debug fails to initialise, and because
    # ZygoteInit.preloadResources() calls Debug.startAllocCounting() first,
    # zygote dies with ExceptionInInitializerError before system_server starts.
    #
    # The value must match the image's storage_list.xml exactly.  This SDK
    # image declares a single fixed "USB storage" volume at /storage/sdcard,
    # so any other path (notably /storage/sdcard0) makes
    # Environment.getStorageVolume() throw and MountService kills system_server
    # in onDaemonConnected -> PackageManagerService.scanAvailableAsecs().
    export EXTERNAL_STORAGE /storage/sdcard

    # SELinux and binder are set up by init itself.  debugfs is not mounted by
    # stock Android; mount it here for tracing and sw_sync diagnostics.
    mkdir /sys/kernel/debug 0755 root root
    mount debugfs debugfs /sys/kernel/debug

    # Android 4.2's liblog opens /dev/log/main (and friends).  The kernel
    # logger driver creates flat /dev/log_* nodes; link the names that the
    # API 17 userspace expects.  `on init` runs after init has replaced /dev
    # with a fresh tmpfs, so anything /init.vita created is already gone.
    mkdir /dev/log 0755 root log
    symlink /dev/log_main /dev/log/main
    symlink /dev/log_radio /dev/log/radio
    symlink /dev/log_events /dev/log/events
    symlink /dev/log_system /dev/log/system

on fs
    # /system and /data are loop-mounted from ur0; /cache is a tmpfs.
    mount_all /fstab.vita

on post-fs-data
    # Android normally lets system_server create /data/system.  We need the
    # directory earlier for the input-device configuration symlinks.
    mkdir /data/system 0771 system system
    chown system system /data/system
    chmod 0771 /data/system

    mkdir /data/system/devices 0750 system system
    mkdir /data/system/devices/keylayout 0750 system system
    mkdir /data/system/devices/idc 0750 system system

    # Wi-Fi state.  The framework opens the supplicant socket at
    # /data/system/wpa_supplicant/<iface> and reads/writes the config as the
    # system user in the wifi group.  /data/misc/wifi is normally created by
    # init.rc, but its ownership is reset here so both root
    # (wpa_supplicant/dhcpcd) and system_server can use it.
    #
    # This file is imported before init.rc's own post-fs-data block, so the
    # parents may not exist yet on a freshly formatted userdata image; Android
    # 4.2's mkdir builtin creates only one level.
    mkdir /data/misc 01771 system misc
    mkdir /data/system 0771 system system
    mkdir /data/misc/wifi 0770 system wifi
    chown system wifi /data/misc/wifi
    chmod 0770 /data/misc/wifi

    mkdir /data/misc/wifi/sockets 0770 system wifi
    chown system wifi /data/misc/wifi/sockets
    chmod 0770 /data/misc/wifi/sockets

    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp
    chmod 0770 /data/misc/dhcp

    mkdir /data/system/wpa_supplicant 0770 system wifi
    chown system wifi /data/system/wpa_supplicant
    chmod 0770 /data/system/wpa_supplicant

    # WifiService refuses to start the supplicant if this file is missing or
    # the SDK image's /system/etc/wifi template is absent.  Seed it before
    # the framework can reach WifiStateMachine; vita-net.sh replaces it with
    # the network block from ur0 later in boot.
    copy /wpa_supplicant.conf /data/misc/wifi/wpa_supplicant.conf
    chown system wifi /data/misc/wifi/wpa_supplicant.conf
    chmod 0660 /data/misc/wifi/wpa_supplicant.conf

    # EventHub looks first in $ANDROID_ROOT/usr/... and then in
    # $ANDROID_DATA/system/devices/... .  /system is a read-only loop mount,
    # so point the second location at files that live on the initramfs.
    symlink /usr/keylayout/PlayStation_Vita_Buttons__Syscon_.kl /data/system/devices/keylayout/PlayStation_Vita_Buttons__Syscon_.kl
    symlink /usr/idc/PlayStation_Vita_Touchscreen__Syscon_.idc /data/system/devices/idc/PlayStation_Vita_Touchscreen__Syscon_.idc

on boot
    # Android's own `on init` sets loglevel 3, which hides init/service and
    # vita-net progress from the framebuffer.  This is a headless bring-up
    # image, so raise it again for the rest of the boot: the console is the
    # only live output until adb is reachable.  boot.log keeps everything
    # regardless.
    loglevel 7

    # The framework is gated so a broken UI cannot hide a working adb boot.
    # These stops run first, then `setprop vita.ui 1` below starts
    # SurfaceFlinger, media, and zygote through the trigger.
    stop zygote
    stop surfaceflinger
    stop media
    stop drm
    stop ril-daemon

    # adb over TCP is the only usable debug transport on this port.
    start adbd

    # The framebuffer is exposed through the kernel's "graphics" class, which
    # ueventd maps to /dev/graphics/fb0.  SurfaceFlinger's fbdev path needs it
    # to be writable by the graphics group.
    chmod 0660 /dev/graphics/fb0 2>/dev/null
    chown root graphics /dev/graphics/fb0 2>/dev/null

    write /proc/sys/vm/swappiness 100

    # This image boots straight to the launcher.  The stops above still run
    # first so a broken UI cannot hide a working adb/headless boot; setting
    # the property here clears SVC_DISABLED and starts the framework through
    # the trigger below.
    setprop vita.ui 1

# `on boot` sets vita.ui=1, so the framework starts automatically.  A manual
# `adb shell setprop vita.ui 1` also works after the core services are up.
# Start SurfaceFlinger first so system_server finds the composer as soon as
# WindowManagerService starts.
#
# The kernel fbcon used to draw printk over the Android framebuffer.  Detach
# it before SurfaceFlinger takes the panel, and stop the init console shell.
#
# `start media` is not optional: AudioService runs early in system_server and
# blocks on media.audio_flinger / media.audio_policy.  The `stop media` above
# clears SVC_DISABLED only when init is told to start it again, so a UI boot
# without this line hangs in "Waiting for service media.audio_flinger...".
on property:vita.ui=1
    stop console
    write /sys/class/vtconsole/vtcon1/bind 0
    loglevel 1
    start surfaceflinger
    start media
    start zygote

# Android's WifiService starts these two services by name through ctl.start.
# The SDK image has no /system/bin/wpa_supplicant, so run the glibc build from
# the initramfs in the foreground; init tracks it for init.svc.wpa_supplicant.
service wpa_supplicant /vita-linux/lib/ld-linux-armhf.so.3 --library-path /vita-linux/lib:/vita-linux/usr/lib /vita-linux/usr/sbin/wpa_supplicant -Dnl80211 -i mlan0 -c /data/misc/wifi/wpa_supplicant.conf -f /data/misc/wifi/wpa_supplicant.log
    class main
    user root
    group root system wifi net_admin net_raw
    disabled

# libnetutils.dhcp_do_request() starts dhcpcd_mlan0 and appends
# "-f /system/etc/dhcpcd/dhcpcd.conf mlan0".  The SDK image has no
# /system/etc/dhcpcd/dhcpcd.conf, so the wrapper ignores those arguments and
# supervises dhcpcd itself.  Keep it running: the framework expects
# init.svc.dhcpcd_mlan0=running while the lease is active.
service dhcpcd_mlan0 /system/bin/sh /vita-dhcp.sh
    class main
    user root
    group root dhcp net_admin net_raw
    disabled

# Keep a synced kernel-log snapshot on ur0.  Android init sets panic_on_oops=1,
# so a kernel oops or a critical-service crash loop can reset the Vita at any
# moment; an unsynced exFAT snapshot does not survive that.  The script snapshots
# every 2 s for two minutes, then every 30 s for ten more minutes and exits.
service vita-log /system/bin/sh /vita-log.sh
    class core
    user root
    group root system
    oneshot

# Wi-Fi and the optional UI marker are handled by late_start scripts.  Both
# run after mount_all, so /system/bin/sh and /mnt/ur0 are available.
service vita-ui /system/bin/sh /vita-ui.sh
    class late_start
    user root
    oneshot

service vita-net /system/bin/sh /vita-net.sh
    class late_start
    user root
    group root net_admin net_raw wifi
    oneshot