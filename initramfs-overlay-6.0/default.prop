#
# ADDITIONAL_DEFAULT_PROPERTIES for AndroidOnVita
#
# ro.secure=0 + ro.adb.secure=0 make adbd run as root without authentication.
# This is a bring-up image; do not expose port 5555 to an untrusted network.
#
ro.secure=0
ro.allow.mock.location=0
ro.debuggable=1
ro.zygote=zygote32
ro.adb.secure=0
persist.sys.usb.config=adb
service.adb.tcp.port=5555

# The SDK image only ships the emulator EGL/GLES drivers. The QEMU one opens a
# host pipe that does not exist on the Vita, so SurfaceFlinger aborts with
# "no suitable EGLConfig found". Reporting "emulator without GPU emulation"
# makes Android 6.0's libEGL load /system/lib/egl/libGLES_android.so, the
# bundled software renderer (libpixelflinger + libETC1). It is GLES1-only,
# which is enough for SurfaceFlinger 6.0's RenderEngine fallback. This is a
# stopgap until a real GPU driver exists; it does not make GLES2 apps work.
ro.kernel.qemu=1
ro.kernel.qemu.gles=0

# Native panel is 960x544. Density 240 gives a 640x363 dp phone-like layout
# instead of the 960x544 dp tablet layout that the unset default produces.
ro.sf.lcd_density=240

# The SDK ramdisk's init.ranchu.rc used to set HWUI cache sizes.  It is removed
# on the Vita, so keep small values here for the 512 MB device.
ro.hwui.texture_cache_size=48
ro.hwui.layer_cache_size=32
ro.hwui.r_buffer_cache_size=8
ro.hwui.path_cache_size=16
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=4
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=1024

# ART heap sizing. The SDK image has no dalvik.vm.heap* properties, so ART
# falls back to its built-in 4m start / 16m maximum, which is far too small
# for system_server, let alone an app. These are the usual values for a
# 512 MB device: 96 MB is the per-app growth limit, 192 MB the large-heap cap.
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=96m
dalvik.vm.heapsize=192m

dalvik.vm.dex2oat-Xms=64m
dalvik.vm.dex2oat-Xmx=512m
dalvik.vm.image-dex2oat-Xms=64m
dalvik.vm.image-dex2oat-Xmx=64m
ro.dalvik.vm.native.bridge=0
