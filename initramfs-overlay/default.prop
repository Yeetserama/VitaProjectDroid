#
# ADDITIONAL_DEFAULT_PROPERTIES for AndroidOnVita
#
# ro.secure=0 + ro.adb.secure=0 make adbd run as root without authentication.
# This is a bring-up image; do not expose port 5555 to an untrusted network.
#
ro.secure=0
ro.allow.mock.location=0
ro.debuggable=1
ro.zygote=zygote32
ro.adb.secure=0
persist.sys.usb.config=adb
service.adb.tcp.port=5555

dalvik.vm.dex2oat-Xms=64m
dalvik.vm.dex2oat-Xmx=512m
dalvik.vm.image-dex2oat-Xms=64m
dalvik.vm.image-dex2oat-Xmx=64m
ro.dalvik.vm.native.bridge=0
