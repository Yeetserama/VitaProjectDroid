# Android 5.1.1 bring-up additions for the PlayStation Vita (PCH-1000).
#
# Merged on top of arch/arm/configs/vita_defconfig with
# scripts/kconfig/merge_config.sh.  CONFIG_MODULES is off in the Vita
# defconfig, so everything Android needs must be built in.
#
# Keep this file sorted roughly by subsystem and add a short comment when a
# symbol exists only because a particular Android component needs it.

# ---------------------------------------------------------------------------
# Core Android IPC / shared memory
# ---------------------------------------------------------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ANDROID_BINDERFS=n
CONFIG_ASHMEM=y
CONFIG_SHMEM=y

# libsync / SurfaceFlinger fences.  SW_SYNC provides /dev/sw_sync; the
# dma-buf one is not the old staging driver and still exists in 6.12.
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y

# ---------------------------------------------------------------------------
# cgroups: Android 5.1 init mounts cpuacct, memory and cpu at boot
# ---------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y

# ---------------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------------
# /system and /data are ext4 images on ur0, which is exFAT.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FS_POSIX_ACL=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Android's sdcard/FUSE daemon and /data/media emulation.
CONFIG_FUSE_FS=y

CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_UNIX98_PTYS=y

# uinput is not required for boot; it makes it possible to inject input
# events from adb while the display path is being debugged.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# ---------------------------------------------------------------------------
# Swap / low-memory support
# ---------------------------------------------------------------------------
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# ---------------------------------------------------------------------------
# SELinux (permissive at boot for bring-up)
# ---------------------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
# The Vita defconfig has no selinux in CONFIG_LSM, so 5.1 init would fail.
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux"

# ---------------------------------------------------------------------------
# Networking: netd, DHCP, Wi-Fi and per-UID routing
# ---------------------------------------------------------------------------
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y

# netd creates dummy0 for the default network on some 5.x devices.
CONFIG_DUMMY=y
CONFIG_TUN=y

CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y

CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y

CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y

# Wi-Fi: mwifiex + SD8787, firmware and regdb are in the initramfs.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_SDIO=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n

# Bluetooth: do not bind the SD8787 Bluetooth SDIO function.  It shares the
# card and firmware with mwifiex, and btmrvl_sdio cannot download its own
# image once the WLAN function has started: it waits ~100 s for the firmware
# to become ready, fails, and the probe/remove cycle resets the SDIO card.
# On the Vita that takes Wi-Fi (and adb) down about every two minutes.  v0.1
# is headless and has no Bluetooth stack, so keep the Marvell transport off
# until there is a reason to debug the shared-firmware handshake.
# CONFIG_BT_MRVL is not set
# CONFIG_BT_MRVL_SDIO is not set

# ---------------------------------------------------------------------------
# Initramfs / userspace conveniences
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y
CONFIG_KEYS=y
CONFIG_INOTIFY_USER=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_AIO=y
CONFIG_FW_LOADER=y

# Android's ueventd is a userspace daemon, not a /sbin/hotplug helper.
CONFIG_UEVENT_HELPER=n

CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION="-vita-android"
