# Read-only SD8787 Bluetooth diagnostic build (re/bt).
#
# vita_defconfig already enables the Marvell BT transport, but
# vita-android.fragment turns it off because the normal probe waits for a
# firmware status that never arrives.  re/bt uses a patched btmrvl_sdio that
# dumps the function-2 registers and returns without downloading firmware,
# so merge this fragment after the Android fragment to re-enable the stack.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_MRVL=y
CONFIG_BT_MRVL_SDIO=y
