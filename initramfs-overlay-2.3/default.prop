#
# ADDITIONAL_DEFAULT_PROPERTIES for AndroidOnVita 2.3.7 (Gingerbread)
#
# ro.secure=0 + ro.adb.secure=0 make adbd run as root without authentication.
# This is a bring-up image; do not expose port 5555 to an untrusted network.
#
ro.secure=0
ro.allow.mock.location=1
ro.debuggable=1
ro.adb.secure=0
persist.sys.usb.config=adb
service.adb.tcp.port=5555

# The SDK image's egl.cfg points at libEGL_emulation.so (the QEMU host pipe).
# /init.vita bind-mounts a replacement that selects libGLES_android.so, the
# bundled software renderer (libpixelflinger + libETC1).  It is GLES1-only,
# which is what SurfaceFlinger 2.3 and Launcher2 use.
ro.kernel.qemu=1
ro.kernel.qemu.gles=0

# Native panel is 960x544. Density 240 gives a 640x363 dp phone-like layout.
ro.sf.lcd_density=240

# Dalvik heap sizing for a 512 MB device.  Gingerbread treats heapsize as the
# per-process maximum; unlike ART, heapgrowthlimit is only a soft threshold.
# The SDK image's eng build enables CheckJNI for every process, which is slow
# and turns recoverable JNI mistakes into aborts.  Turn it off for bring-up;
# re-enable it only when chasing a specific JNI bug.
dalvik.vm.heapsize=64m
dalvik.vm.heapgrowthlimit=48m
dalvik.vm.heapstartsize=5m
ro.kernel.android.checkjni=0

# The system image is odexed; there is no dex2oat/ART in Gingerbread.
