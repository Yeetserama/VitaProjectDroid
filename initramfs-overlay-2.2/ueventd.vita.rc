# Device permissions for the PlayStation Vita (Android 2.2).
#
# This file is loaded by ueventd after /ueventd.rc.

/dev/graphics/fb0       0660   root       graphics
/dev/sw_sync            0660   system     graphics
/dev/ttyS0              0660   root       system
/dev/mmcblk0            0660   root       system
/dev/mmcblk0p12         0660   root       system
/dev/block/mmcblk0p12   0660   root       system
/dev/zram0              0660   root       system
/dev/block/zram0        0660   root       system
/dev/logger/log_main    0660   root       log
/dev/logger/log_radio   0660   root       log
/dev/logger/log_events  0660   root       log
/dev/logger/log_system  0660   root       log
/dev/lowmemorykiller    0660   root       system
/dev/ashmem             0660   root       system
/dev/binder             0660   root       system