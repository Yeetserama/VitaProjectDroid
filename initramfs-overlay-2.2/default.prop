#
# ADDITIONAL_DEFAULT_PROPERTIES for AndroidOnVita 2.2 (Froyo)
#
ro.secure=0
ro.allow.mock.location=1
ro.debuggable=1
ro.adb.secure=0
persist.sys.usb.config=adb
service.adb.tcp.port=5555

# Software renderer fallback for SurfaceFlinger
# Android 2.2 uses libGLES_android.so (PixelFlinger) for GLES 1.x
ro.kernel.qemu=1
ro.kernel.qemu.gles=0

# Native panel is 960x544. Density 240 gives a phone-like layout
ro.sf.lcd_density=240

# Dalvik heap sizing for 512 MB device
# Froyo uses different property names
dalvik.vm.heapsize=192m
dalvik.vm.heapgrowthlimit=64m
dalvik.vm.heapstartsize=8m

# JIT compiler (available in 2.2)
dalvik.vm.execution-mode=introspect:jit

# No DEX2OAT (ART not present in 2.2)